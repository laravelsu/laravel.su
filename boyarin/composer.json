{
    "name": "laravel-russia/boyarin",
    "description": "Standalone Telegram anti-spam webhook service",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "assisted-mindfulness/naive-bayes": "^2.0",
        "illuminate/console": "^13.23",
        "illuminate/events": "^13.23",
        "illuminate/support": "^13.23",
        "monolog/monolog": "^3.10",
        "react/http": "^1.11",
        "react/socket": "^1.16",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Boyarin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Boyarin\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-root-package-install": [
            "@setup"
        ],
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('resources/trusted-users.json') || copy('resources/trusted-users.example.json', 'resources/trusted-users.json');\""
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan start"
        ],
        "test": "phpunit"
    }
}
